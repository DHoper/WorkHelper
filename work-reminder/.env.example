# Work Reminder 環境配置檔
# 複製此檔案為 .env 並填入您的設定值

# === 基礎設定 ===
# 應用程式名稱
APP_NAME=工作提醒小幫手

# 環境模式 (development | production)
NODE_ENV=development

# === 資料庫設定 ===
# SQLite 資料庫路徑 (預設會在使用者目錄下建立)
# DATABASE_PATH=~/work-reminder/database

# === 護眼提醒設定 ===
# 預設間隔時間（分鐘）
EYE_CARE_DEFAULT_INTERVAL=60

# 預設是否啟用聲音提醒
EYE_CARE_SOUND_ENABLED=true

# === 未來功能配置 (預留) ===
# OpenAI Whisper API 設定
# WHISPER_API_KEY=your_whisper_api_key_here
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_MODEL=whisper-1
# WHISPER_LANGUAGE=zh

# Google Calendar API 設定
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# === 通知設定 ===
# 系統通知設定
ENABLE_SYSTEM_NOTIFICATIONS=true

# 通知聲音檔案路徑（可自訂）
# NOTIFICATION_SOUND_PATH=./assets/sounds/notification.wav

# === 開發設定 ===
# Vite 開發伺服器埠號
VITE_PORT=5173

# Electron 開發模式
ELECTRON_IS_DEV=true

# === 其他設定 ===
# 日誌層級 (error | warn | info | debug)
LOG_LEVEL=info

# 自動更新檢查
ENABLE_AUTO_UPDATE=true

# 崩潰報告
ENABLE_CRASH_REPORTS=false